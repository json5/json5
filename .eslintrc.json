{
    "root": true,
    "env": {
        "es2020": true
    },
    "extends": [
        "standard",
        "plugin:node/recommended"
    ],
    "parserOptions": {
        "ecmaVersion": 2020
    },
    "rules": {
        "array-bracket-spacing": [
            "error",
            "never"
        ],
        "arrow-parens": [
            "error",
            "as-needed"
        ],
        "camelcase": [
            "error",
            { "allow": ["^LOWER_[a-z]", "^_\\$", "^[A-Z][a-zD]+(_[A-Z][a-z]+)+$"] }
        ],
        "comma-dangle": [
            "error",
            "always-multiline"
        ],
        "indent": [
            "error",
            4
        ],
        "no-process-exit": "off",
        "object-curly-spacing": [
            "error",
            "never"
        ],
        "yoda": [
            "error",
            "never",
            { "exceptRange": true }
        ]
    }
}
